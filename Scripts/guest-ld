#!/usr/bin/env python3
"""Link a guest image with Apple's ld and repair Thumb pointers before signing."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile

from arm32_thumb_fixups import repaired_image


def main():
    args = sys.argv[1:]
    linker = subprocess.check_output(["xcrun", "--find", "ld"], text=True).strip()
    if args in (["-v"], ["-version_details"], ["-help"]):
        return subprocess.call([linker, *args])
    if any(arg.startswith("@") and not arg.startswith(
            ("@rpath/", "@loader_path/", "@executable_path/")) for arg in args):
        raise ValueError("linker response files are not supported; pass explicit arguments/-filelist")
    if any(arg in args for arg in ("-s", "-x", "-r", "-no_pie")):
        raise ValueError("Thumb repair requires an unstripped final PIE image/dylib; strip after linking")
    if args.count("-o") != 1 or args.count("-arch") != 1:
        raise ValueError("expected one explicit -o and -arch")
    output_index = args.index("-o") + 1
    arch = args[args.index("-arch") + 1]
    if arch not in ("armv6", "armv7", "armv7s", "armv7k"):
        raise ValueError(f"guest linker only supports ARM32, not {arch}")
    output = Path(args[output_index])
    # Never publish a malformed or partially repaired build product. Theos
    # runs stripping/signing only after this wrapper returns successfully.
    fd, temporary = tempfile.mkstemp(prefix=".lc32-link-", dir=output.parent)
    os.close(fd)
    temporary = Path(temporary)
    try:
        command = args.copy()
        command[output_index] = str(temporary)
        if "-dylib" in args and "-install_name" not in args and "-dylib_install_name" not in args:
            command += ["-install_name", str(output)]
        status = subprocess.call([linker, *command, "-no_adhoc_codesign"])
        if status:
            return status
        repaired, count = repaired_image(temporary.read_bytes())
        if count:
            temporary.write_bytes(repaired)
            print(f"LC32: repaired {count} Thumb pointer(s) in {output.name}", file=sys.stderr)
        os.replace(temporary, output)
        return 0
    finally:
        temporary.unlink(missing_ok=True)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, ValueError, IndexError, subprocess.CalledProcessError) as error:
        raise SystemExit(f"guest-ld: {error}")
